<UserControl
    x:Class="MaiziWPF.Modules.Sys.UserListView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:domain="clr-namespace:MaiziWPF.Services.Domain;assembly=MaiziWPF.Services.Domain"
    xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:maiziWPF="clr-namespace:MaiziWPF.Core;assembly=MaiziWPF.Core"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:prism="http://prismlibrary.com/"
    prism:ViewModelLocator.AutoWireViewModel="True">
    <Border Background="WhiteSmoke" CornerRadius="0 0 10 0">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <!--  左边部门树  -->
            <Border BorderBrush="#eee" BorderThickness="0,0,1,0">
                <StackPanel Margin="10,10,6,6">
                    <materialDesign:Card Padding="8,4,8,4">
                        <DockPanel>
                            <Button Style="{StaticResource MaterialDesignToolButton}">
                                <materialDesign:PackIcon Kind="Search" Opacity=".56" />
                            </Button>
                            <TextBox
                                materialDesign:HintAssist.Hint="请输入部门名称"
                                materialDesign:TextFieldAssist.DecorationVisibility="Hidden"
                                materialDesign:TextFieldAssist.HasClearButton="True"
                                BorderThickness="0"
                                FontSize="16"
                                Text="{Binding SearchDeptText}" />
                        </DockPanel>
                    </materialDesign:Card>
                    <materialDesign:TreeListView ItemsSource="{Binding DeptItems}">
                        <i:Interaction.Triggers>
                            <i:EventTrigger EventName="SelectionChanged">
                                <prism:InvokeCommandAction Command="{Binding DeptSelectionCommand}" CommandParameter="{Binding SelectedItem, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=materialDesign:TreeListView}}" />
                            </i:EventTrigger>
                        </i:Interaction.Triggers>
                        <materialDesign:TreeListView.Resources>
                            <HierarchicalDataTemplate DataType="{x:Type domain:SysDept}" ItemsSource="{Binding Childs}" />
                        </materialDesign:TreeListView.Resources>
                        <materialDesign:TreeListView.View>
                            <GridView>
                                <GridView.ColumnHeaderContainerStyle>
                                    <Style TargetType="GridViewColumnHeader">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </Style>
                                </GridView.ColumnHeaderContainerStyle>
                                <GridView.Columns>
                                    <GridViewColumn Width="210">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding DeptName}" />
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                </GridView.Columns>
                            </GridView>
                        </materialDesign:TreeListView.View>
                    </materialDesign:TreeListView>
                </StackPanel>
            </Border>
            <!--  右边列表  -->
            <Grid Grid.Column="1" Margin="0,10,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <!--  条件  -->
                <WrapPanel>
                    <materialDesign:Card Width="200" Style="{StaticResource FormCardStyle}">
                        <TextBox
                            materialDesign:HintAssist.Hint="请输入用户名称"
                            materialDesign:TextFieldAssist.DecorationVisibility="Hidden"
                            materialDesign:TextFieldAssist.HasClearButton="True"
                            BorderThickness="0"
                            FontSize="16" />
                    </materialDesign:Card>
                    <materialDesign:Card Width="200" Style="{StaticResource FormCardStyle}">
                        <TextBox
                            materialDesign:HintAssist.Hint="请输入手机号码"
                            materialDesign:TextFieldAssist.DecorationVisibility="Hidden"
                            materialDesign:TextFieldAssist.HasClearButton="True"
                            BorderThickness="0"
                            FontSize="16" />
                    </materialDesign:Card>
                    <materialDesign:Card Width="200" Style="{StaticResource FormCardStyle}">
                        <ComboBox
                            maiziWPF:DataDictAssist.Type="sys_normal_disable"
                            materialDesign:HintAssist.Hint="用户状态"
                            materialDesign:TextFieldAssist.DecorationVisibility="Hidden"
                            materialDesign:TextFieldAssist.HasClearButton="True"
                            BorderThickness="0"
                            FontSize="16">
                            <ComboBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type domain:SysDictData}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding DictLabel}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </materialDesign:Card>
                    <materialDesign:Card Width="280" Style="{StaticResource FormCardStyle}">
                        <maiziWPF:DateRangeControl EndDateTime="{Binding SearchEndDate, Mode=TwoWay}" StartDateTime="{Binding SearchStartDate, Mode=TwoWay}" />
                    </materialDesign:Card>
                    <StackPanel Margin="6,0,0,6" Orientation="Horizontal">
                        <Button
                            Margin="0,0,8,0"
                            Background="#1890ff"
                            BorderBrush="#1890ff"
                            Command="{Binding SearchButtonCommand}"
                            Content="搜索"
                            Foreground="#fff"
                            Style="{StaticResource MaterialDesignRaisedLightButton}" />
                        <Button
                            BorderBrush="#dcdfe6"
                            Content="重置"
                            Foreground="#606266"
                            Style="{StaticResource MaterialDesignOutlinedDarkButton}" />
                    </StackPanel>
                </WrapPanel>
                <!--  表格  -->
                <DataGrid Grid.Row="1" />
            </Grid>
        </Grid>
    </Border>
</UserControl>
