<UserControl
    x:Class="MaiziWPF.ExpanderMenuControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:MaiziWPF"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <UserControl.Resources>
        <local:ExpanderArrowConverter x:Key="ExpanderArrowConverter" />
    </UserControl.Resources>
    <Expander Background="Transparent" Header="{Binding MenuName}">
        <Expander.Style>
            <Style BasedOn="{StaticResource MaterialDesignExpander}" TargetType="Expander">
                <Setter Property="materialDesign:ExpanderAssist.ExpanderButtonContent" Value="{Binding Childs, Converter={StaticResource ExpanderArrowConverter}}" />
            </Style>
        </Expander.Style>
        <Expander.HeaderTemplate>
            <DataTemplate>
                <Border>
                    <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="{Binding DataContext.Icon, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=Expander}}" />
                        <TextBlock Margin="5,0,0,0" Text="{Binding}" />
                    </StackPanel>
                    <Border.Style>
                        <Style TargetType="Border">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding DataContext.Level, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=Expander}}" Value="2">
                                    <Setter Property="Padding" Value="20,0,0,0" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding DataContext.Level, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=Expander}}" Value="3">
                                    <Setter Property="Padding" Value="40,0,0,0" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                </Border>
            </DataTemplate>
        </Expander.HeaderTemplate>
        <ItemsControl ItemsSource="{Binding Childs}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <local:ExpanderMenuControl />
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Expander>
</UserControl>
