<UserControl
    x:Class="MaiziWPF.ExpanderMenuControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:domain="clr-namespace:MaiziWPF.Services.Domain;assembly=MaiziWPF.Services.Domain"
    xmlns:local="clr-namespace:MaiziWPF"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <UserControl.Resources>
        <Style x:Key="MenuButtonStyle" TargetType="RadioButton">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#707db2" />
            <Setter Property="Margin" Value="0,0,0,5" />
            <Setter Property="Height" Value="45" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Tag" Value="#6673b7" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border
                            Background="{TemplateBinding Background}"
                            BorderBrush="Transparent"
                            BorderThickness="4,0,0,0">
                            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="#bccaf1" />
                    <Setter Property="Tag" Value="#7071f0" />
                    <Setter Property="Background">
                        <Setter.Value>
                            <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                <GradientStop Offset="0" Color="#31407b" />
                                <GradientStop Offset="3" Color="#495385" />
                            </LinearGradientBrush>
                        </Setter.Value>
                    </Setter>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="RadioButton">
                                <Border
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="#afa1f5"
                                    BorderThickness="4,0,0,0">
                                    <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center" />
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Trigger>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="RadioButton">
                                <Border
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="#afa1f5"
                                    BorderThickness="4,0,0,0">
                                    <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center" />
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Trigger>
                <DataTrigger Binding="{Binding Level}" Value="1">
                    <Setter Property="Command" Value="{Binding DataContext.MenuSelectionCommand, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=ItemsControl}}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Level}" Value="2">
                    <Setter Property="Command" Value="{Binding DataContext.MenuSelectionCommand, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=ItemsControl, AncestorLevel=2}}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Level}" Value="3">
                    <Setter Property="Command" Value="{Binding DataContext.MenuSelectionCommand, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType=ItemsControl, AncestorLevel=3}}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="MenuButtonIconStyle" TargetType="materialDesign:PackIcon">
            <Setter Property="Width" Value="20" />
            <Setter Property="Height" Value="20" />
            <Setter Property="Foreground" Value="{Binding Tag, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type RadioButton}}}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Level}" Value="1">
                    <Setter Property="Margin" Value="20,0,6,0" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Level}" Value="2">
                    <Setter Property="Margin" Value="40,0,6,0" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Level}" Value="3">
                    <Setter Property="Margin" Value="60,0,6,0" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="MenuButtonTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type RadioButton}}}" />
        </Style>
        <Style x:Key="MenuExpanderStyle" TargetType="Expander">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#707db2" />
            <Setter Property="Tag" Value="#6673b7" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Expander">
                        <StackPanel>
                            <Border>
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="Transparent" />
                                        <Setter Property="Padding" Value="24,0,0,0" />
                                        <Setter Property="BorderThickness" Value="4,0,0,0" />
                                        <Setter Property="Height" Value="45" />
                                        <Setter Property="Margin" Value="0,0,0,5" />
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="BorderBrush" Value="#afa1f5" />
                                                <Setter Property="Background">
                                                    <Setter.Value>
                                                        <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                                            <GradientStop Offset="0" Color="#31407b" />
                                                            <GradientStop Offset="3" Color="#495385" />
                                                        </LinearGradientBrush>
                                                    </Setter.Value>
                                                </Setter>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="50" />
                                    </Grid.ColumnDefinitions>
                                    <ContentPresenter ContentSource="Header" />
                                    <ToggleButton
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        Foreground="#707db2"
                                        IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                        Style="{StaticResource MaterialDesignExpanderToggleButton}" />
                                </Grid>
                            </Border>
                            <ContentPresenter x:Name="ExpandSite" />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="False">
                                <Setter TargetName="ExpandSite" Property="Visibility" Value="Collapsed" />
                            </Trigger>
                            <Trigger Property="IsExpanded" Value="True">
                                <Setter TargetName="ExpandSite" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="MenuExpanderButtonTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Expander}}}" />
        </Style>
        <Style x:Key="MenuExpanderButtonIconStyle" TargetType="materialDesign:PackIcon">
            <Setter Property="Width" Value="20" />
            <Setter Property="Height" Value="20" />
            <Setter Property="Foreground" Value="{Binding Tag, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type Expander}}}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Level}" Value="1">
                    <Setter Property="Margin" Value="0,0,6,0" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Level}" Value="2">
                    <Setter Property="Margin" Value="35,0,6,0" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Level}" Value="3">
                    <Setter Property="Margin" Value="55,0,6,0" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <DataTemplate x:Key="MenuExpanderDataTemplate" DataType="{x:Type domain:SysMenu}">
            <Expander Style="{StaticResource MenuExpanderStyle}">
                <Expander.Header>
                    <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="{Binding Icon}" Style="{StaticResource MenuExpanderButtonIconStyle}" />
                        <TextBlock Style="{StaticResource MenuExpanderButtonTextStyle}" Text="{Binding MenuName}" />
                    </StackPanel>
                </Expander.Header>
                <ItemsControl ItemsSource="{Binding Childs}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <local:ExpanderMenuControl />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Expander>
        </DataTemplate>
        <DataTemplate x:Key="MenuButtonDataTemplate" DataType="{x:Type domain:SysMenu}">
            <RadioButton
                CommandParameter="{Binding}"
                GroupName="SelectionGroup"
                Style="{StaticResource MenuButtonStyle}">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="{Binding Icon}" Style="{StaticResource MenuButtonIconStyle}" />
                    <TextBlock Style="{StaticResource MenuButtonTextStyle}" Text="{Binding MenuName}" />
                </StackPanel>
            </RadioButton>
        </DataTemplate>
    </UserControl.Resources>
    <ContentControl Content="{Binding}" ContentTemplateSelector="{DynamicResource selector}">
        <ContentControl.Resources>
            <local:MenuDataTemplateSelector
                x:Key="selector"
                MenuButton="{StaticResource MenuButtonDataTemplate}"
                MenuExpander="{StaticResource MenuExpanderDataTemplate}" />
        </ContentControl.Resources>
    </ContentControl>
</UserControl>
